# Cache rules for statically-served assets.
#
# These are served by Cloudflare's asset layer, which answers before the Worker
# runs — so worker.ts never sees the request and cannot set the header itself.
# Every filename below is content-addressed (the hash changes when the bytes
# change), which is what makes an immutable year safe.

/media/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/vector/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
