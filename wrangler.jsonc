// Cloudflare Worker for the Raja Enterprises site.
//
// Two R2 bindings rather than S3 credentials: a binding cannot be copied out
// of the deployment, cannot be replayed from a laptop, and has no key to
// rotate. PRIVATE_DOCS holds client RFPs and BOQs and is never served
// directly — an authenticated route streams it after checking the session.
//
// Secrets (DATABASE_URL, RAJA_ADMIN_EMAIL, RAJA_ADMIN_PASSWORD,
// RAJA_PBKDF2_ITERATIONS) are set with `wrangler secret put` and deliberately
// do NOT appear here: this file is committed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raja-enterprises",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA",
      "bucket_name": "raja-public-media"
    },
    {
      "binding": "PRIVATE_DOCS",
      "bucket_name": "raja-private-documents"
    }
  ],
  "observability": {
    "enabled": true
  }
}
